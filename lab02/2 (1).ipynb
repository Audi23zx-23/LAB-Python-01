      "source": [
        "# Calcular la suma de los primeros n numeros naturales\n",
        "n = 10\n",
        "suma = 0\n",
        "\n",
        "for i in range(1, n + 1):\n",
        "    suma += i\n",
        "    # Imprimir solo los pares usando if\n",
        "    if i % 2 == 0:\n",
        "        print(f\"Número par: {i}\")\n",
        "\n",
        "print(f\"La suma de los primeros {n} números naturales es: {suma}\")"
      ],
